# Example environment variables for the MatchUp frontend (Vite)
# Copy this file to `.env` and adjust values for your environment.

# Base URL of the backend API the frontend should call
VITE_API_BASE=http://127.0.0.1:8000

# Public base path for the built app (optional)
VITE_PUBLIC_PATH=/

# Application name (display / meta)
VITE_APP_NAME=MatchUp

# Feature flags / optional integrations
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_KEY=
